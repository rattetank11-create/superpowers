# Скопируйте в .env и заполните: cp .env.example .env

# Домен сайта. Локально — localhost; на VPS — ваш домен (A-запись должна указывать на VPS).
DOMAIN=localhost

# PostgreSQL
POSTGRES_USER=cs2
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=cs2

# Лимиты
MAX_UPLOAD_MB=500
CHUNK_SIZE_MB=8
RATE_LIMIT_UPLOADS_PER_HOUR=10
JOB_TIMEOUT_SECONDS=900
WORKER_MEM_LIMIT=3g
